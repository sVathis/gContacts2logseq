# Absolute path to your Logseq contacts directory on the host.
# On WSL2 this is typically /mnt/c/Users/<username>/path/to/Contacts
LOGSEQ_CONTACTS_DIR=/mnt/c/Users/spiros/Contacts

# How often to sync, in seconds. Default: 3600 (1 hour).
# Set to 0 to run once and exit (useful for testing).
SYNC_INTERVAL_SECONDS=3600

# Paths inside the container to the OAuth files (pre-mounted via docker-compose volumes).
TOKEN_FILE=/secrets/token.json
CREDENTIALS_FILE=/secrets/credentials.json

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
